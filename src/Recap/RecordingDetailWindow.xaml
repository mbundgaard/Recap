<Window x:Class="Recap.RecordingDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording" Height="900" Width="1120" MinHeight="700" MinWidth="940"
        Background="#14181D" WindowStartupLocation="CenterOwner"
        Icon="Assets/icon.png">
    <Window.Resources>
        <Style x:Key="DeskButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderBrush" Value="#D7D1C6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="Foreground" Value="#22272E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource DeskButton}">
            <Setter Property="Background" Value="#22272E" />
            <Setter Property="Foreground" Value="#FFFDF8" />
            <Setter Property="BorderBrush" Value="#22272E" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="BorderBrush" Value="#D7D1C6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#22272E" CornerRadius="26" Padding="24" BorderBrush="#323A44" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Meeting" FontSize="14" FontWeight="SemiBold" Foreground="#A9B0BA" />
                    <Grid Margin="0,7,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleText" Text="Recording" FontSize="30" FontWeight="Bold" Foreground="#FFFDF8" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource DeskButton}" Width="34" Padding="0" Margin="8,0,0,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#A9B0BA" ToolTip="Rename meeting" AutomationProperties.Name="Rename meeting" Click="Rename_Click" />
                    </Grid>
                    <TextBlock x:Name="MetaText" Text="" FontSize="13" Foreground="#A9B0BA" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,44,0,0">
                    <TextBlock Text="Audio" Foreground="#FFFDF8" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="Prepare this meeting to listen back or transcribe." Foreground="#A9B0BA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Button x:Name="PrepareAudioButton" Content="Prepare audio" Style="{StaticResource DeskButton}" Click="PrepareAudio_Click" HorizontalAlignment="Stretch" ToolTip="Prepare meeting audio for playback and transcription." />
                    <TextBlock Text="Spoken language" Foreground="#A9B0BA" FontSize="12" Margin="0,18,0,6" />
                    <ListBox x:Name="LanguageBox" SelectedValuePath="Code" SelectionMode="Single"
                             Background="#171B20" BorderThickness="0" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Spoken language">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter />
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
                                <Setter Property="Foreground" Value="#A9B0BA" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Option" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,10">
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Option" Property="Background" Value="#323A44" />
                                                    <Setter Property="Foreground" Value="#FFFDF8" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Option" Property="Background" Value="#FFFDF8" />
                                                    <Setter Property="Foreground" Value="#22272E" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Option" Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="3" Background="#171B20" CornerRadius="20" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Meeting playback" Foreground="#FFFDF8" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="MixedAudioStatusText" Text="Prepare audio before playback" Foreground="#7F8895" FontSize="12" Margin="0,4,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SkipBackButton" Content="−10" ToolTip="Back 10 seconds" AutomationProperties.Name="Back 10 seconds" Width="54" Style="{StaticResource DeskButton}" Click="SkipBack_Click" />
                            <Button x:Name="PlayMixedButton" Grid.Column="1" Content="▶ Play" Style="{StaticResource DeskButton}" Background="#FFFDF8" Click="PlayMixed_Click" Margin="10,0" />
                            <Button Grid.Column="2" x:Name="SkipForwardButton" Content="+10" ToolTip="Forward 10 seconds" AutomationProperties.Name="Forward 10 seconds" Width="54" Style="{StaticResource DeskButton}" Click="SkipForward_Click" />
                        </Grid>

                        <Slider x:Name="PlaybackSlider" Style="{StaticResource PlaybackTimeline}" AutomationProperties.Name="Playback position" Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True" PreviewMouseDown="PlaybackSlider_PreviewMouseDown" PreviewMouseUp="PlaybackSlider_PreviewMouseUp" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="PlaybackPositionText" Text="00:00" Foreground="#7F8895" FontSize="11" />
                            <TextBlock x:Name="PlaybackDurationText" Text="00:00" Foreground="#7F8895" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="#F7F1E7" CornerRadius="26" Padding="24" BorderBrush="#E0D8CB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Processing" FontSize="17" FontWeight="SemiBold" Foreground="#22272E" Margin="0,0,0,10" />

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFDF8" BorderBrush="#E0D8CB" BorderThickness="1" CornerRadius="20" Padding="18">
                        <StackPanel>
                            <TextBlock Text="1. Speech recognition" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#22272E" FontSize="15" />
                            <TextBlock x:Name="SttStatusText" Text="Not started" Foreground="#6B6258" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />
                            <ProgressBar x:Name="SpeechProgress" Visibility="Collapsed" Height="6" Margin="0,12,0,14"
                                         Minimum="0" Maximum="100" Foreground="#1E8E5A" Background="#E0D8CB"
                                         BorderThickness="0" AutomationProperties.Name="Speech recognition progress" />
                            <Button x:Name="TranscribeButton" Content="Recognize speech" Style="{StaticResource DarkButton}" Click="Transcribe_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFDF8" BorderBrush="#E0D8CB" BorderThickness="1" CornerRadius="20" Padding="18">
                        <StackPanel>
                            <TextBlock Text="2. Speaker names" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#22272E" FontSize="15" />
                            <TextBlock x:Name="SpeakerStatusText" Text="No speakers loaded" Foreground="#6B6258" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />
                            <Button x:Name="SaveNamesButton" Content="Confirm speakers" Style="{StaticResource DarkButton}" Click="SaveSpeakers_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#FFFDF8" BorderBrush="#E0D8CB" BorderThickness="1" CornerRadius="20" Padding="18">
                        <StackPanel>
                            <TextBlock Text="3. Final transcript" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#22272E" FontSize="15" />
                            <TextBlock x:Name="FinalStatusText" Text="Locked" Foreground="#6B6258" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />
                            <Button x:Name="GenerateButton" Content="Create transcript" Style="{StaticResource DarkButton}" Click="Generate_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MaxHeight="320" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Identify speakers" FontSize="17" FontWeight="SemiBold" Foreground="#22272E" VerticalAlignment="Center" />
                        <StackPanel x:Name="SpeakerPager" Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PreviousSpeakerPageButton" Content="&lt;" Style="{StaticResource DeskButton}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#6B6258" Click="PreviousSpeakerPage_Click" ToolTip="Previous speakers" AutomationProperties.Name="Previous speakers page" />
                            <Button x:Name="NextSpeakerPageButton" Content="&gt;" Style="{StaticResource DeskButton}" Width="28" Height="28" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#6B6258" Click="NextSpeakerPage_Click" ToolTip="Next speakers" AutomationProperties.Name="Next speakers page" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                            <ItemsControl x:Name="SpeakersList" ItemsSource="{Binding VisibleSpeakers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFDF8" BorderBrush="#E0D8CB" BorderThickness="1" CornerRadius="18" Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" Foreground="#22272E" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox x:Name="SpeakerNameInput" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Speaker name" />
                                                <Button Grid.Column="2" Content="‹" Width="28" Padding="0" Style="{StaticResource DeskButton}" IsEnabled="{Binding HasPreviousSample}" Click="PreviousSample_Click" ToolTip="Previous turn by this speaker" AutomationProperties.Name="Previous speaker turn" />
                                                <TextBlock Grid.Column="3" Text="{Binding SampleDisplay}" ToolTip="{Binding SampleCountDisplay}" FontSize="11" Foreground="#6B6258" Margin="8,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="4" Content="›" Width="28" Padding="0" Style="{StaticResource DeskButton}" IsEnabled="{Binding HasNextSample}" Click="NextSample_Click" ToolTip="Next turn by this speaker" AutomationProperties.Name="Next speaker turn" />
                                                <Button Grid.Column="5" Content="Play" Width="56" Padding="0" Style="{StaticResource DeskButton}" Margin="8,0,0,0" Click="PlaySample_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="EmptySpeakersPanel" Background="#FFFDF8" BorderBrush="#E0D8CB" BorderThickness="1" CornerRadius="18" Padding="18">
                                <TextBlock x:Name="EmptySpeakersText" Text="Transcribe first. Then listen to a short sample and name each speaker." Foreground="#6B6258" TextWrapping="Wrap" />
                            </Border>

                            <Grid x:Name="SpeakerNamingNotice" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SpeakerNamingHint" Foreground="#6B6258" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button x:Name="NextUnnamedSpeakerButton" Grid.Column="1" Content="Next unnamed" Style="{StaticResource DeskButton}" Height="28" Padding="6,0" Background="Transparent" BorderThickness="0" Foreground="#6B6258" Click="NextUnnamedSpeaker_Click" ToolTip="Go to the next speaker who needs a name" />
                            </Grid>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Transcript" FontSize="17" FontWeight="SemiBold" Foreground="#22272E" Margin="0,16,0,10" />
                    <Border Grid.Row="3" Background="#FFFDF8" BorderBrush="#E0D8CB" BorderThickness="1" CornerRadius="18" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FlowDocumentScrollViewer x:Name="TranscriptPreview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Background="Transparent" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button x:Name="CopyTranscriptButton" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#6B6258" Style="{StaticResource DeskButton}" Click="CopyTranscript_Click" ToolTip="Copy transcript" AutomationProperties.Name="Copy transcript" Margin="0,0,4,0" />
                                    <Button x:Name="SaveTranscriptButton" Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#6B6258" Style="{StaticResource DeskButton}" Click="SaveTranscript_Click" ToolTip="Save transcript as Markdown" AutomationProperties.Name="Save transcript" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
