<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Recap.ProcessingTests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Agent\skill.md" LogicalName="Recap.AgentSkill" />
    <EmbeddedResource Include="LocalWhisper\worker.py" LogicalName="Recap.LocalWhisper.worker.py" />
    <EmbeddedResource Include="LocalWhisper\community-1.json" LogicalName="Recap.LocalWhisper.community-1.json" />
    <EmbeddedResource Include="LocalWhisper\requirements-cpu.txt" LogicalName="Recap.LocalWhisper.requirements-cpu.txt" />
    <EmbeddedResource Include="LocalWhisper\requirements-cuda.txt" LogicalName="Recap.LocalWhisper.requirements-cuda.txt" />
    <AssemblyMetadata Include="RecapSingleFile" Value="$(PublishSingleFile)" />
    <EmbeddedResource Include="Updates\update-public-key.pem" LogicalName="Recap.UpdatePublicKey" />
    <None Remove="Assets\icon.ico" />
    <None Remove="Assets\icon.png" />
    <None Remove="Assets\logo.png" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\logo.png" />
    <None Remove="Assets\logo-dark.png" />
    <Resource Include="Assets\logo-dark.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.52.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
