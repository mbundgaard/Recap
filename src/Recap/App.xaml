<Application x:Class="Recap.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <!-- Focus adorners are shown for keyboard navigation and never participate in layout. -->
  <Style x:Key="KeyboardFocusVisual" TargetType="Control">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Control">
      <Rectangle Margin="3" Stroke="#1E8E5A" StrokeThickness="1" StrokeDashArray="2 2"
                 RadiusX="5" RadiusY="5" IsHitTestVisible="False" />
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
  </Style>
  <Style x:Key="PlaybackTimeline" TargetType="Slider">
   <Setter Property="Height" Value="28" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Margin="7,0" Background="{TemplateBinding Background}">
       <Border Height="4" Background="#414B58" CornerRadius="2" VerticalAlignment="Center" />
       <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#72C47B" CornerRadius="2" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="14" Height="14">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFFDF8" /></ControlTemplate></Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#414B58" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>
